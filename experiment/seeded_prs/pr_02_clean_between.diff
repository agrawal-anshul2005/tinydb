@@ -0,0 +1,32 @@
+import pytest
+from hypothesis import given, settings, strategies as st
+from tinydb import TinyDB, Query, where
+from tinydb.storages import MemoryStorage
+
+
+@settings(max_examples=50, derandomize=True, deadline=None)
+@given(a=st.integers(-50, 50), b=st.integers(-50, 50), x=st.integers(-60, 60))
+def test_pbt_between_bounds(a, b, x):
+    lo, hi = min(a, b), max(a, b)
+    assert where("v").between(lo, hi, inclusive=True)({"v": x}) == (lo <= x <= hi)
+    assert where("v").between(lo, hi, inclusive=False)({"v": x}) == (lo < x < hi)
+
+
+def test_between_cache_and_edge_cases():
+    db = TinyDB(storage=MemoryStorage)
+    db.insert_multiple([{"x": 10}, {"x": 15}, {"x": 20}, {"x": None}, {"x": "bad"}])
+
+    q_inc = Query().x.between(10, 20, inclusive=True)
+    q_exc = Query().x.between(10, 20, inclusive=False)
+    assert q_inc != q_exc
+    assert [d["x"] for d in db.search(q_inc)] == [10, 15, 20]
+    assert [d["x"] for d in db.search(q_exc)] == [15]
+
+    with pytest.raises(ValueError):
+        Query().between(1, 5)
