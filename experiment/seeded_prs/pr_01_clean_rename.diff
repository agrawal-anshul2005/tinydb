+++ b/tests/test_seeded_pr_01.py
@@ -0,0 +1,28 @@
+import pytest
+from hypothesis import given, settings, strategies as st
+from tinydb import TinyDB, where
+from tinydb.operations import rename
+from tinydb.storages import MemoryStorage
+
+
+@settings(max_examples=50, derandomize=True, deadline=None)
+@given(
+    old_k=st.text(alphabet="abcdefghijklmnopqrstuvwxyz", min_size=1, max_size=6),
+    new_k=st.text(alphabet="abcdefghijklmnopqrstuvwxyz", min_size=1, max_size=6),
+    val=st.integers(min_value=-100, max_value=100),
+)
+def test_pbt_rename_preserves_value(old_k, new_k, val):
+    db = TinyDB(storage=MemoryStorage)
+    db.insert({old_k: val, "keep": True})
+    db.update(rename(old_k, new_k))
+    doc = db.all()[0]
+    assert doc[new_k] == val
+    assert doc["keep"] is True
+    if old_k != new_k:
+        assert old_k not in doc
+
+
+def test_rename_missing_raises_keyerror():
+    db = TinyDB(storage=MemoryStorage)
+    db.insert({"a": 1})
+    with pytest.raises(KeyError):
+        db.update(rename("missing", "b"))
