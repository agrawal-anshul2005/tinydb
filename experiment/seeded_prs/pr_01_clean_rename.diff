@@ -72,4 +72,21 @@ def decrement(field: str) -> Callable[[MutableMapping], None]:
     def transform(doc: MutableMapping):
         doc[field] -= 1
 
     return transform
+
+
+def rename(old_field: str, new_field: str) -> Callable[[MutableMapping], None]:
+    """
+    Rename ``old_field`` to ``new_field`` in the document.
+    """
+    def transform(doc: MutableMapping):
+        if old_field not in doc:
+            raise KeyError(old_field)
+        if old_field == new_field:
+            return
+        doc[new_field] = doc.pop(old_field)
+
+    return transform
