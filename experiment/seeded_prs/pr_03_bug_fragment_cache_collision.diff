+++ b/tests/test_seeded_pr_03.py
@@ -0,0 +1,11 @@
+from tinydb import Query
+
+
+def test_fragment_non_mapping_returns_false():
+    q = Query().a.fragment({'x': 1})
+    assert not q({'a': None})
+    assert not q({'a': 42})
+    assert not q({'a': 'str'})
+    assert q({'a': {'x': 1, 'y': 2}})
